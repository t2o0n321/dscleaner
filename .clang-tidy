# dscleaner lint baseline. Run from the repo root:
#   clang-tidy src/*.cpp src/*/*.cpp -- -std=c++17 -Iinclude
#
# Deliberately disabled checks (with rationale):
#   performance-avoid-endl        - std::endl is intentional: the long-running
#                                   `watch` daemon writes to launchd log files
#                                   and we want each line flushed promptly.
#   misc-include-cleaner          - too noisy; flags transitive STL includes.
#   misc-no-recursion             - the directory walkers are intentionally
#                                   recursive (bounded by tree depth).
#   bugprone-easily-swappable-parameters - flags legitimate (in_fd, out_fd) and
#                                   (src_fd, dst_fd) APIs shaped like POSIX
#                                   read/write; parameter names make intent clear.
#   modernize-use-trailing-return-type / *-braces-around-statements - stylistic,
#                                   already covered by .clang-format.
Checks: >
  -*,
  bugprone-*,
  google-*,
  performance-*,
  misc-*,
  modernize-use-override,
  modernize-use-nullptr,
  readability-identifier-naming,
  -performance-avoid-endl,
  -misc-include-cleaner,
  -misc-no-recursion,
  -bugprone-easily-swappable-parameters,
  -google-readability-todo
WarningsAsErrors: ''
HeaderFilterRegex: '.*\.hpp$'
FormatStyle: file
